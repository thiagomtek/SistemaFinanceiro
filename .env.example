DB_NAME=financeiro
DB_USER=financeiro
DB_PASS=troque-esta-senha
DB_ROOT_PASS=troque-esta-senha-root
APP_PORT=8097
# Chave da API Gemini (leitura de fatura em PDF). Nunca versionar o .env real.
GEMINI_API_KEY=
# Web Push (notificacao no celular/navegador). Chaves PROPRIAS deste sistema (nao reutilizar as do ERP); nunca versionar o .env real.
# Gerar: docker compose run --rm --no-deps --entrypoint php fin_app -r 'require "/var/www/vendor/autoload.php"; print_r(Minishlink\WebPush\VAPID::createVapidKeys());'
# Subject: mailto:alguem@exemplo.com ou a URL https do sistema.
PUSH_VAPID_PUBLIC=
PUSH_VAPID_PRIVATE=
PUSH_VAPID_SUBJECT=
